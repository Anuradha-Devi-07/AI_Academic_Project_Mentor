# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (started with `docker compose up -d`). The password here must match DATABASE_URL.
DB_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://projectmentor:change-me@127.0.0.1:5432/projectmentor
# Or, without Docker, a local SQLite file:
# DATABASE_URL=sqlite:///./projectmentor.db

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_HOURS=168

# Frontend address(es) allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:5173"]

# Forgot password without an emailed code (classroom demo only — anyone who knows
# an email can change that account's password). Keep false for real users.
ALLOW_UNVERIFIED_PASSWORD_RESET=true
